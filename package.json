{
  "name": "sanad-erp",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-tenant SaaS ERP for customer service, helpdesk, and technical support.",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/plans.test.ts tests/permissions.test.ts tests/auth-validation.test.ts tests/billing-gating.test.ts tests/tickets-sla.test.ts tests/knowledge-base.test.ts tests/analytics.test.ts tests/canned-responses.test.ts tests/notifications.test.ts tests/leaderboard.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@hookform/resolvers": "5.9.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.4",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.59.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "pusher": "5.3.4",
    "pusher-js": "8.6.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}

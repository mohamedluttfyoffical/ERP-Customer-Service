# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database (PostgreSQL 15+)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sanad_erp?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (generate with: openssl rand -base64 48)
# ---------------------------------------------------------------------------
AUTH_SECRET="development-only-secret-change-me-0123456789abcdef0123456789abcdef"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Seed bootstrap (change before any non-local use)
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL="owner@sanad.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!Phase1"
SEED_SUPER_ADMIN_NAME="Platform Owner"
SEED_DEMO_TENANT_SLUG="demo"
SEED_DEMO_DATA="true"
SEED_DEMO_OWNER_EMAIL="demo.owner@sanad.local"
SEED_DEMO_OWNER_PASSWORD="ChangeMe!DemoPhase1"
SEED_DEMO_OWNER_NAME="Demo Owner"

# ---------------------------------------------------------------------------
# Billing - Stripe (Phase 3)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PORTAL_CONFIGURATION_ID=""
# Optional: map seeded plan prices to Stripe Price objects during deployment.
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_PROFESSIONAL_MONTHLY=""
STRIPE_PRICE_PROFESSIONAL_ANNUAL=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_ANNUAL=""

# ---------------------------------------------------------------------------
# Real-time - Pusher (Phase 4/5). Leave empty to fall back to polling in dev.
# ---------------------------------------------------------------------------
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ---------------------------------------------------------------------------
# File storage (configured in a later phase; DB stores metadata and storage keys)
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
